_site/
.quarto/
/.luarc.json

/.quarto/
**/*.quarto_ipynb

# Quarto writes outputs next to the sources during a render and moves them into
# _site/ at the end; ignore any leftovers from an interrupted render.
/*.html
# ...but not the hand-written includes (_a11y.html, _analytics.html, _sim-tools.html).
!/_*.html
/site_libs/
concepts/*.html
themes/*.html
kinds/*.html
r/*.html
tours/*.html
**/*-listing.json
**/*_files/
__pycache__/

